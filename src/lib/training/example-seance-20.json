    {
      "id": "row",
      "name": {
        "fr": "Tirage debout",
        "en": "Standing row"
      },
      "zone": "dos",
      "dose": {
        "kind": "reps",
        "reps": 8
      },
      "tempo": "2-0-2",
      "cues": {
        "fr": [
          "Poitrine ouverte.",
          "Coudes frottent les côtes.",
          "Épaules loin des oreilles."
        ],
        "en": [
          "Chest open.",
          "Elbows graze the ribs.",
          "Shoulders away from the ears."
        ]
      },
      "mistake": {
        "fr": "Hausser les épaules vers les oreilles.",
        "en": "Shrugging toward the ears."
      },
      "easier": {
        "fr": "Amplitude plus courte, dos contre un mur.",
        "en": "Shorter range, back against a wall."
      },
      "bpm": 56,
      "video": {
        "asset": "assets/coach-videos/row-coach-afrique-ouest.mp4",
        "inMs": 0,
        "outMs": 12000
      },
      "shot": {
        "framing": "Corps entier, tête aux pieds, marge autour des mains.",
        "angle": "Trois-quarts face, caméra à hauteur de hanche.",
        "durationSec": 12,
        "repsToFilm": 8,
        "tempo": "2-0-2",
        "light": "Lumière douce de face, pas de contre-jour.",
        "background": "Mur clair uni, sol dégagé, cadre stable du premier au dernier photogramme.",
        "status": "reutiliser",
        "note": "Clip Moussa. Utile pour l’échauffement du dos et le bloc principal."
      }
    },
