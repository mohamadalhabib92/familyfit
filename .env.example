# FamilyFit — copier en .env et remplacer les valeurs YOUR_*.
# Sans ces valeurs (ou tant qu'elles commencent par YOUR_), l'app démarre en mode essai :
# une famille d'exemple reste sur l'appareil. Aucun écran technique.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Journal de crash. YOUR_* ou absent = désactivé, aucun envoi.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Ne jamais mettre dans l'app : YOUR_OTP_PROVIDER (Authentication → Providers, dans Supabase).
# Ne jamais mettre la clé service_role.
# EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
# YOUR_TEEN_MIN_AGE (défaut produit 16 — comptes ado, passe ultérieure)
# YOUR_REVIEW_ACCOUNT (compte de revue des stores, à créer par Mohamed)
# EXPO_PUBLIC_FEATURE_HEALTH=false
# EXPO_PUBLIC_FEATURE_EXTERNAL_CAL_SYNC=false
