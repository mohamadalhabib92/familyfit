# FamilyFit — copier en .env et remplacer les valeurs YOUR_*.
# Sans URL et clé anon, ou tant qu’elles restent YOUR_*, l’app démarre en mode essai
# (famille d’exemple sur cet appareil). Aucun écran « Configuration requise ».
# Ne jamais mettre la clé service_role dans ce fichier ni dans l’app.

EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Journal des plantages. Absent ou YOUR_* = désactivé. Aucun envoi au démarrage.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Affiché dans l’app seulement si ce n’est plus un placeholder.
EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL

# Âge minimal du futur compte ado. YOUR_* ou vide = défaut 16 dans le code.
EXPO_PUBLIC_TEEN_MIN_AGE=YOUR_TEEN_MIN_AGE

# Inactifs sauf valeur exactement true. Ne pas les activer sans Mohamed.
EXPO_PUBLIC_FEATURE_HEALTH=false
EXPO_PUBLIC_FEATURE_EXTERNAL_CAL_SYNC=false

# YOUR_OTP_PROVIDER : Authentication dans Supabase, jamais dans l’app.
# YOUR_REVIEW_ACCOUNT : compte de revue store, à créer par Mohamed, pas dans le client.
